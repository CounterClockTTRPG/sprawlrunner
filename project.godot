; Engine configuration file.
config_version=5

[application]

config/name="Sprawlrunner"
config/description="Overhead cyberpunk action roguelike: drive Kessler Bay, meet contacts, run the shadows."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="disabled"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Sprawlrunner"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.04, 1)
textures/canvas_textures/default_texture_filter=1
